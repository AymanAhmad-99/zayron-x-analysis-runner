# ═══════════════════════════════════════════════════════════════
# ZAYRON-X — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in all values.
# ⚠️  NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ── DATABASE (Direct PostgreSQL via Supabase Pooler - Port 6543) ─────────────────
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"

# ── SUPABASE (Server-side SSR Auth + Drizzle) ─────────────────
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── SUPABASE (Browser client — NEXT_PUBLIC_ prefix required) ──
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ── REDIS (Upstash — rate limiting + caching) ─────────────────
REDIS_URL=YOUR_UPSTASH_REDIS_URL_HERE
REDIS_TOKEN=YOUR_UPSTASH_REDIS_TOKEN_HERE

# ── EMAIL (Resend — newsletter delivery) ──────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# ── ADMIN (HTTP Basic Auth for /admin/* routes) ───────────────
ADMIN_USER=YOUR_ADMIN_USERNAME_HERE
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# ── SITE (Public URL and branding) ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zayron-x.com
NEXT_PUBLIC_SITE_NAME=ZAYRON-X

# ── ISR (On-demand revalidation) ──────────────────────────────
REVALIDATION_SECRET=YOUR_REVALIDATION_SECRET_HERE

# ── AI PIPELINE (Python workers) ──────────────────────────────
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── NIST NVD (CVE worker) ─────────────────────────────────────
NVD_API_KEY=YOUR_NVD_API_KEY_HERE

# ── TELEGRAM (MTProto ingestion) ──────────────────────────────
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE
