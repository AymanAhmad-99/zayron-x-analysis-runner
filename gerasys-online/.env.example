# ZAYRON-X — Environment Configuration
# Copy to .env.local and fill in real values
# ⚠️  NEVER commit .env.local to version control

# ═══════════════════════════════════════════════════════════════
# Supabase — Server-side (Drizzle ORM + SSR Auth)
# ═══════════════════════════════════════════════════════════════
# Direct PostgreSQL connection via Supabase pooler (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres

# Supabase project URL
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Anon key — public, used for server-side SSR cookie auth
SUPABASE_ANON_KEY=[ANON_KEY]

# ⚠️  SERVICE_ROLE key — bypasses RLS, full database access
# Used by: Python workers, admin operations, migrations
# Shared var name for both Python (os.getenv) and Next.js (process.env)
SUPABASE_SERVICE_KEY=[SERVICE_ROLE_KEY]

# ═══════════════════════════════════════════════════════════════
# Supabase — Browser client (NEXT_PUBLIC_ prefix required)
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]

# ═══════════════════════════════════════════════════════════════
# Redis — Upstash (rate limiting + cache)
# ═══════════════════════════════════════════════════════════════
REDIS_URL=[UPSTASH_REDIS_URL]
REDIS_TOKEN=[UPSTASH_REDIS_TOKEN]

# ═══════════════════════════════════════════════════════════════
# Resend — Email delivery (newsletter)
# ═══════════════════════════════════════════════════════════════
RESEND_API_KEY=[RESEND_API_KEY]

# ═══════════════════════════════════════════════════════════════
# Admin — Basic Auth credentials for /admin/*
# ═══════════════════════════════════════════════════════════════
ADMIN_USER=[ADMIN_USERNAME]
ADMIN_PASSWORD=[ADMIN_PASSWORD]

# ═══════════════════════════════════════════════════════════════
# Site — Public URL and branding
# ═══════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://zayron-x.com
NEXT_PUBLIC_SITE_NAME=ZAYRON-X

# ═══════════════════════════════════════════════════════════════
# On-demand ISR Revalidation — Webhook secret
# ═══════════════════════════════════════════════════════════════
REVALIDATION_SECRET=[REVALIDATION_SECRET]

# ═══════════════════════════════════════════════════════════════
# LLM — AI pipeline credentials (Python workers)
# ═══════════════════════════════════════════════════════════════
LLM_API_KEY=[OPENAI_OR_COMPATIBLE_API_KEY]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
DEEPSEEK_API_KEY=[DEEPSEEK_API_KEY]
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ═══════════════════════════════════════════════════════════════
# Sentry — Error tracking & performance monitoring
# ═══════════════════════════════════════════════════════════════
# The DSN is the ONLY variable required for error reporting.
# Upload as a WORKER SECRET (never commit the real value):
#   wrangler secret put NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=https://[PUBLIC_KEY]@o[ORG_ID].ingest.us.sentry.io/[PROJECT_ID]

# Auth token for source-map uploads during `next build`.
# Create at: Sentry → Settings → Account → API → Auth Tokens
# Required scopes: project:releases, org:read
# Upload as a WORKER SECRET:
#   wrangler secret put SENTRY_AUTH_TOKEN
SENTRY_AUTH_TOKEN=[SENTRY_AUTH_TOKEN]

# Optional — Sentry org and project slugs.
# These can also be set in next.config.ts via withSentryConfig().
# SENTRY_ORG=zayron-x
# SENTRY_PROJECT=zayron-x-web

# ═══════════════════════════════════════════════════════════════
# NIST NVD — CVE worker (optional, higher rate limits)
# ═══════════════════════════════════════════════════════════════
NVD_API_KEY=[NVD_API_KEY]

# ═══════════════════════════════════════════════════════════════
# Telegram — MTProto credentials (radar-engine.py)
# ═══════════════════════════════════════════════════════════════
TELEGRAM_API_ID=[TELEGRAM_API_ID]
TELEGRAM_API_HASH=[TELEGRAM_API_HASH]

# ═══════════════════════════════════════════════════════════════
# PYTHON WORKER NOTE:
# Python scripts read `SUPABASE_SERVICE_KEY` (unified name).
# Set it to the same service_role JWT token used above.
# Before this audit, Python used `SUPABASE_KEY` — update your
# VPS environment to use `SUPABASE_SERVICE_KEY` instead.
# ═══════════════════════════════════════════════════════════════
