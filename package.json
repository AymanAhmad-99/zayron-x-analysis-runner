{
  "name": "zayron-x-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun run test:unit",
    "test:unit": "node tools/run-unit-tests.mjs",
    "check:provenance": "node tools/check-build-provenance.mjs",
    "check:worker-compat": "node tools/check-worker-compatibility.mjs",
  "deploy:web:prod": "node tools/deploy-web-production.mjs",
    "ingest": "bun run scripts/corpus_pipeline_ingest.ts",
    "verify": "bun run scripts/corpus_pipeline_verify.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250815.0",
    "@types/node": "^26.4.1",
    "@zip.js/zip.js": "2.7.53",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.96.0"
  }
}
