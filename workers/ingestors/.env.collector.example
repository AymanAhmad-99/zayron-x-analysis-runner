# ZAYRON-X 24/7 Telegram Collector Configuration
# Real values are provisioned via Cloudflare Secrets — never commit live credentials here.
TELEGRAM_API_ID=<YOUR_TELEGRAM_API_ID>
TELEGRAM_API_HASH=<YOUR_TELEGRAM_API_HASH>
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_FILE=/data/telegram/zayron_collector.session
DATA_DIR=/data/telegram
PORT=8080

WEBHOOK_URL=https://zayron-x-api.aabusabih.workers.dev/api/v1/webhook/telegram
HEARTBEAT_URL=https://zayron-x-api.aabusabih.workers.dev/api/v1/admin/collector-heartbeat
SOURCES_URL=https://zayron-x-api.aabusabih.workers.dev/api/v1/sources

# Inject these values through Cloudflare Secrets or a local untracked environment file; never commit them.
# TELEGRAM_API_ID and TELEGRAM_API_HASH are required by the login helper scripts.
# TELEGRAM_SESSION_STRING must be supplied as a secret for authenticated collection.
