[Unit]
Description=ZAYRON-X Autonomous 24/7 Telegram CTI Collector Daemon
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=zayron
Group=zayron
WorkingDirectory=/opt/zayron-collector
ExecStart=/opt/zayron-collector/venv/bin/python autonomous_collector.py
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/data/telegram
EnvironmentFile=-/etc/zayron/collector.env

# Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
