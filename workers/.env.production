# ============================================================================
# ZAYRON-X Multi-Agent Ingestion Crew — Production Environment Configuration
# ============================================================================

# ──────────────────────────────────────────────
# 1. AI API Configuration
# ──────────────────────────────────────────────
# Secure Gemini Developer Access API Key
GEMINI_API_KEY=YOUR_GEMINI_PRODUCTION_API_KEY

# Model assignments (Pro for reasoning/weaver/synthesis, Flash for harvesting/quant)
GEMINI_PRO_MODEL=gemini-1.5-pro-latest
GEMINI_FLASH_MODEL=gemini-1.5-flash-latest

# ──────────────────────────────────────────────
# 2. Persistence Layer Configuration
# ──────────────────────────────────────────────
# Supabase project REST API endpoints
SUPABASE_URL=https://your-project-id.supabase.co
# service_role key required to bypass RLS policies during backend writes
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ──────────────────────────────────────────────
# 3. Secure Tor SOCKS5 Routing
# ──────────────────────────────────────────────
# Coordinates of the companion Docker Tor Proxy container (linked service)
TOR_PROXY=socks5://tor_proxy:9050

# ──────────────────────────────────────────────
# 4. Crew Operational Constraints
# ──────────────────────────────────────────────
# Polling interval in minutes to check raw_feeds table
CREW_POLL_INTERVAL=5
# Maximum rows claimed per iteration (SKIP LOCKED semantics)
CREW_BATCH_SIZE=3
# Retry limit per agent inside CrewAI task boundaries
MAX_RETRIES_PER_AGENT=2

# ──────────────────────────────────────────────
# 5. Presentation Layer Cache Invalidation (ISR)
# ──────────────────────────────────────────────
# Next.js frontend on-demand cache revalidation endpoint
REVALIDATION_URL=https://zayron-app.vercel.app/api/revalidate
# Shared cryptographic secret to authorize revalidation triggers
REVALIDATION_SECRET=YOUR_SECURE_REVALIDATION_SECRET
