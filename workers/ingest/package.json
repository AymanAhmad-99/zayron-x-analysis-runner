{
  "name": "@zayron/worker-ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"console.error('[deploy] generic deploy is disabled. Use deploy:preview (guarded). Production is a separate, explicitly authorized process.'); process.exit(1)\"",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:preview:dry-run": "node scripts/deploy-preview.mjs --dry-run",
    "deploy:production": "node ../../scripts/release/production-release-gate.mjs ingest-production -- npx wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250815.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.96.0"
  }
}
