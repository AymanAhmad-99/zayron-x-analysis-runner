    "deploy:production": "node ../../scripts/release/production-release-gate.mjs syndicate-production -- npx wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250815.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.96.0"
  }
}
