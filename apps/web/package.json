    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "@zayron/intelligence": "workspace:*",
    "@zayron/types": "workspace:*",
    "@zayron/ui": "workspace:*",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.13",
  "ignoreScripts": [
