{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build && node scripts/patch-handler.js",
    "deploy:preview": "node scripts/patch-handler.js && opennextjs-cloudflare deploy --env preview",
