{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zayron-x-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "services": [{ "binding": "API", "service": "zayron-x-api-preview" }],
  "vars": {
    "ENVIRONMENT": "preview",
    "NEXT_PUBLIC_SITE_URL": "https://zayron-x-web-preview.aabusabih.workers.dev",
    "NEXT_PUBLIC_API_BASE_URL": "https://zayron-x-api-preview.aabusabih.workers.dev/api/v1",
    "API_BASE_URL": "https://zayron-x-api-preview.aabusabih.workers.dev/api/v1"
  },
  "env": {
    "production": {
      "name": "zayron-x-web",
      "workers_dev": false,
      "routes": [
        { "pattern": "zayron-x.co/*", "zone_name": "zayron-x.co" },
        { "pattern": "www.zayron-x.co/*", "zone_name": "zayron-x.co" }
      ],
      "services": [{ "binding": "API", "service": "zayron-x-api" }],
      "vars": {
        "ENVIRONMENT": "production",
        "NEXT_PUBLIC_SITE_URL": "https://zayron-x.co",
        "NEXT_PUBLIC_API_BASE_URL": "https://zayron-x.co/api/v1",
        "API_BASE_URL": "https://api.zayron-x.co/api/v1",
        "SITEMAP_MAX_SHARDS": "10",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGSdu64i5QZQpr03"
      }
    },
    "preview": {
      "name": "zayron-x-web-preview",
      "workers_dev": true,
      "routes": [],
      "services": [{ "binding": "API", "service": "zayron-x-api-preview" }],
      "vars": {
        "ENVIRONMENT": "preview",
        "NEXT_PUBLIC_SITE_URL": "https://zayron-x-web-preview.aabusabih.workers.dev",
        "NEXT_PUBLIC_API_BASE_URL": "https://zayron-x-api-preview.aabusabih.workers.dev/api/v1",
        "API_BASE_URL": "https://zayron-x-api-preview.aabusabih.workers.dev/api/v1"
      }
    }
  }
}
