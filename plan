```yaml
version: "3.9"

# ═══════════════════════════════════════════════════
# ZAYRON-X Production Orchestration — Isolated Services
# ═══════════════════════════════════════════════════

services:
  # ──── Service 1: Omni-Crew (AI Processing Pipeline) ────
  zayron_crew:
    build:
      context: ..
      dockerfile: workers/Dockerfile.workers
    container_name: zayron_crew_daemon
    restart: always
    depends_on:
      tor_proxy:
        condition: service_healthy
    env_file:
      - ../.env
    environment:
      - TOR_PROXY=socks5://tor_proxy:9050
