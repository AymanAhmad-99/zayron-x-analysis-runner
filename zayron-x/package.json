{
  "name": "zayron-x",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "build:cf": "opennextjs-cloudflare build --skipNextBuild",
    "postbuild:cf": "node scripts/patch-handler-fs.cjs",
    "deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "architecture:readiness": "node scripts/architecture-readiness.mjs",
    "analyze": "ANALYZE=true bun run build",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "playwright test",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy:preview": "node ../scripts/verify_opennext_build.cjs && wrangler deploy --env preview",
    "deploy:production": "node ../scripts/verify_opennext_build.cjs && wrangler deploy --env production"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.4",
    "date-fns": "3.6.0",
    "framer-motion": "11.18.2",
    "fuse.js": "7.1.0",
    "lenis": "^1.3.23",
    "lucide-react": "0.487.0",
    "next": "^16.2.6",
    "next-intl": "^4.0.2",
    "next-themes": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-highlight": "7.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "resend": "4.2.0",
    "sharp": "0.34.1",
    "stripe": "^22.2.0",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.45.0",
    "@sentry/nextjs": "^8.30.0",
    "@types/node": "22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^2.1.0",
    "wrangler": "^4.96.0"
  }
}
