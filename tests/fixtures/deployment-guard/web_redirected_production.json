{
  "name": "zayron-x-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "zayron-x.co/*", "zone_name": "zayron-x.co" },
    { "pattern": "www.zayron-x.co/*", "zone_name": "zayron-x.co" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_SITE_URL": "https://zayron-x.co",
    "NEXT_PUBLIC_API_BASE_URL": "https://zayron-x-api-preview.aabusabih.workers.dev/api/v1"
  },
  "env": {
    "production": { "name": "zayron-x-web" },
    "preview": { "name": "zayron-x-web-preview" }
  }
}
