# ============================================================================
# ZAYRON-X — SOVEREIGN SERVERLESS ENVIRONMENT CONFIG (.env.example)
# ============================================================================
# Architecture: 100% Cloudflare Sovereign Serverless (Workers, D1, R2, Vectorize)
# ============================================================================

# Cloudflare Infrastructure
CLOUDFLARE_ACCOUNT_ID=56534d53775d8280011a325dcf36ed09
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>

# Database & Storage Bindings
D1_DATABASE_ID=c19c8f45-801b-4034-bd76-402e5e5389b5
VECTORIZE_INDEX_NAME=zayron-knowledge-index
R2_BUCKET_KNOWLEDGE=zayron-x-knowledge
R2_BUCKET_STORAGE=zayron-x-storage

# Production Domain & API URL
NEXT_PUBLIC_APP_URL=https://zayron-x.co

# Telegram Distribution (Optional for Outbound Alerts)
TELEGRAM_BOT_TOKEN=<OPTIONAL_TELEGRAM_BOT_TOKEN>
TELEGRAM_TARGET_CHANNEL=zayronxai

# ============================================================================
# PHASE 7A — Developer API (zayron-x-api)
# ----------------------------------------------------------------------------
# NEVER commit real values. Set these on the Worker instead:
#   cd workers/api && npx wrangler secret put API_KEY_PEPPER
#   cd workers/api && npx wrangler secret put TURNSTILE_SECRET_KEY   # optional
#
# API_KEY_PEPPER       — HMAC-SHA256 pepper for 48-character token digests.
#                        REQUIRED: self-serve key issuance returns 503 until set.
# TURNSTILE_SECRET_KEY — optional bot gate. When set, POST /api/v1/keys/self-serve
#                        also requires a Turnstile token, which means the web
#                        worker must carry the matching public site key:
#                        NEXT_PUBLIC_TURNSTILE_SITE_KEY (a public `[vars]` value,
#                        not a secret) — rebuild/redeploy zayron-x-web after adding.
# ============================================================================
API_KEY_PEPPER=<GENERATE_A_64_CHAR_RANDOM_SECRET>
TURNSTILE_SECRET_KEY=<OPTIONAL_TURNSTILE_SECRET>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<OPTIONAL_TURNSTILE_SITE_KEY>
