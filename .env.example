# ============================================================================
# ZAYRON-X MASTER BLUEPRINT — SINGLE SOURCE OF TRUTH (SSOT) ENVIRONMENT CONFIG
# ============================================================================
# Core Reference: 2027 Silicon Valley 12-Factor App Paradigm
# Security Notice: NEVER commit the active .env file containing real secrets.
# Always keep the active .env gitignored.
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 1. ENTERPRISE COGNITIVE ENGINE (GEMINI PRO INTEGRATION)
# ────────────────────────────────────────────────────────────────────────────
# Enterprise premium 1-year unrestricted API access key.
# This key unlocks the maximum resource limits and context windows.
# [REQUIRED]
GEMINI_API_KEY=<ENTERPRISE_1YR_UNRESTRICTED_GEMINI_PRO_API_KEY>

# Default highest-tier model for heavy cognitive reasoning and synthesis tasks (2M Context Window).
# Recommended: gemini-1.5-pro-latest or models/gemini-1.5-pro-002
# [REQUIRED]
GEMINI_PRO_MODEL=gemini-1.5-pro-latest

# High-throughput model optimized for low-latency, rapid, low-weight extraction and triage.
# Recommended: gemini-1.5-flash-latest or models/gemini-1.5-flash-002
# [REQUIRED]
GEMINI_FLASH_MODEL=gemini-1.5-flash-latest

# ────────────────────────────────────────────────────────────────────────────
# 2. PERSISTENCE LAYER (SUPABASE DATABASE & STORAGE)
# ────────────────────────────────────────────────────────────────────────────
# Absolute URL of the Supabase API Gateway instance.
# [REQUIRED]
SUPABASE_URL=https://<SUPABASE_PROJECT_ID>.supabase.co

# High-privilege service_role JWT key bypassing Row Level Security (RLS) policies.
# CAUTION: Never expose this key to the frontend client. Keeps database transactions secure.
# [REQUIRED]
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_ROLE_SECRET_KEY>

# ────────────────────────────────────────────────────────────────────────────
# 3. SECURE TOR NETWORK EGRESS (PROXY ORCHESTRATION)
# ────────────────────────────────────────────────────────────────────────────
# Absolute address of the Tor SOCKS5 outbound routing daemon.
# Forces all scraping traffic through dynamic IP rotation paths to avoid rate limits/blocks.
# [REQUIRED]
TOR_PROXY=socks5://tor_proxy:9050

# ────────────────────────────────────────────────────────────────────────────
# 4. PRESENTATION LAYER CACHE REVALIDATION (NEXT.JS ISR WEBHOOKS)
# ────────────────────────────────────────────────────────────────────────────
# Target absolute URL of the Next.js on-demand revalidation API route.
# Triggers instant static page generation (ISR) when the database processes new threat logs.
# [REQUIRED]
REVALIDATION_URL=https://<NEXT_PUBLIC_APP_URL>/api/revalidate

# Shared cryptographic authorization key verifying webhook origin authenticity.
# [REQUIRED]
REVALIDATION_SECRET=<CRYPTOGRAPHICALLY_SECURE_ISR_WEBHOOK_SECRET>

# ────────────────────────────────────────────────────────────────────────────
# 5. CREW OPERATIONS AND RESOURCE TUNING
# ────────────────────────────────────────────────────────────────────────────
# Polling frequency (in minutes) for the Crew background daemon to inspect raw_feeds database.
# [REQUIRED]
CREW_POLL_INTERVAL=5

# Maximum quantity of unprocessed feeds claimed in a single transactional batch (SKIP LOCKED semantics).
# [REQUIRED]
CREW_BATCH_SIZE=3

# Maximum execution retries allowed per agent inside CrewAI task boundaries before failing gracefully.
# [REQUIRED]
MAX_RETRIES_PER_AGENT=2

# Verbose operational logging output gate (set to true to enable raw debug telemetry).
# [OPTIONAL]
CREW_DEBUG=false
