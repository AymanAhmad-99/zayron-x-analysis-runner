workers/api/.dryrun-*/
workers/api/workers/

# Next / vinext build output
apps/web/dist/
apps/web/.vinext/

# Backup snapshots (point-in-time copies, not source)
.zayron/backups/
db/backups/

# Malware samples captured by validation runs — never commit
workers/malware-validation/malware-artifacts/

# Vendored upstream checkout (embedded git repo, not our source)
vendor/osv-schema/

